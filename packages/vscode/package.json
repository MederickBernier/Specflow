{
  "name": "specflow-vscode",
  "displayName": "Specflow",
  "description": "Spec-driven development: run tasks through your agent harness, trace them in git, and catch drift.",
  "version": "0.1.0",
  "private": true,
  "publisher": "specflow",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "spec",
    "specification",
    "requirements",
    "traceability",
    "claude",
    "agent"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.specs/config.yml",
    "workspaceContains:.specs/**/*.md",
    "onWebviewPanel:specflow.workbench"
  ],
  "contributes": {
    "commands": [
      {
        "command": "specflow.init",
        "title": "Initialize specs",
        "category": "Specflow"
      },
      {
        "command": "specflow.openWorkbench",
        "title": "Open workbench",
        "category": "Specflow",
        "icon": "$(dashboard)"
      },
      {
        "command": "specflow.refresh",
        "title": "Refresh specs",
        "category": "Specflow",
        "icon": "$(refresh)"
      },
      {
        "command": "specflow.checkHarness",
        "title": "Check harness",
        "category": "Specflow"
      },
      {
        "command": "specflow.runTask",
        "title": "Run task",
        "category": "Specflow",
        "icon": "$(play)"
      },
      {
        "command": "specflow.cancelRun",
        "title": "Cancel run",
        "category": "Specflow"
      },
      {
        "command": "specflow.acceptRun",
        "title": "Accept and commit",
        "category": "Specflow",
        "icon": "$(check)"
      },
      {
        "command": "specflow.discardRun",
        "title": "Discard changes",
        "category": "Specflow",
        "icon": "$(discard)"
      },
      {
        "command": "specflow.openDiff",
        "title": "Open diff",
        "category": "Specflow"
      },
      {
        "command": "specflow.showTrace",
        "title": "Trace",
        "category": "Specflow"
      },
      {
        "command": "specflow.checkDrift",
        "title": "Check drift",
        "category": "Specflow"
      },
      {
        "command": "specflow.lint",
        "title": "Lint",
        "category": "Specflow"
      },
      {
        "command": "specflow.show",
        "title": "Show",
        "category": "Specflow"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "specflow.init",
          "when": "!specflow.hasSpecs"
        },
        {
          "command": "specflow.openWorkbench",
          "when": "specflow.hasSpecs"
        },
        {
          "command": "specflow.refresh",
          "when": "specflow.hasSpecs"
        },
        {
          "command": "specflow.checkHarness",
          "when": "specflow.hasSpecs"
        },
        {
          "command": "specflow.runTask",
          "when": "specflow.hasSpecs"
        },
        {
          "command": "specflow.cancelRun",
          "when": "specflow.hasSpecs"
        },
        {
          "command": "specflow.acceptRun",
          "when": "specflow.reviewing"
        },
        {
          "command": "specflow.discardRun",
          "when": "specflow.reviewing"
        },
        {
          "command": "specflow.openDiff",
          "when": "false"
        },
        {
          "command": "specflow.showTrace",
          "when": "specflow.hasSpecs"
        },
        {
          "command": "specflow.checkDrift",
          "when": "specflow.hasSpecs"
        },
        {
          "command": "specflow.lint",
          "when": "specflow.hasSpecs"
        },
        {
          "command": "specflow.show",
          "when": "specflow.hasSpecs"
        }
      ],
      "view/title": [
        {
          "command": "specflow.openWorkbench",
          "when": "view == specflow.specs",
          "group": "navigation@0"
        },
        {
          "command": "specflow.refresh",
          "when": "view == specflow.specs",
          "group": "navigation"
        },
        {
          "command": "specflow.acceptRun",
          "when": "view == specflow.review",
          "group": "navigation@1"
        },
        {
          "command": "specflow.discardRun",
          "when": "view == specflow.review",
          "group": "navigation@2"
        },
        {
          "command": "specflow.checkDrift",
          "when": "view == specflow.specs",
          "group": "1_drift"
        }
      ],
      "view/item/context": [
        {
          "command": "specflow.runTask",
          "when": "view == specflow.specs && viewItem == task",
          "group": "inline"
        },
        {
          "command": "specflow.runTask",
          "when": "view == specflow.specs && viewItem == task",
          "group": "1_run"
        },
        {
          "command": "specflow.showTrace",
          "when": "view == specflow.specs && viewItem =~ /^(requirement|task)$/",
          "group": "2_trace"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "specflow.specs",
          "name": "Specs",
          "when": "specflow.hasSpecs"
        },
        {
          "id": "specflow.review",
          "name": "Run review",
          "when": "specflow.reviewing"
        }
      ]
    },
    "configuration": {
      "title": "Specflow",
      "properties": {
        "specflow.harness": {
          "type": "string",
          "default": "",
          "description": "Agent harness to use on this machine, overriding harness.default in .specs/config.yml. Leave empty to use the config."
        },
        "specflow.confirmRuns": {
          "type": "boolean",
          "default": true,
          "description": "Ask before each run, showing the task, harness and commit mode."
        },
        "specflow.driftOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Run the rule-based drift check whenever a spec file is saved. It reads the git history, so it can take a few seconds in large repositories."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p webview/tsconfig.json && node scripts/build.mts",
    "test:smoke": "pnpm build && esbuild test/smoke/index.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=dist-test/smoke.js && node test/run.ts",
    "package": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p webview/tsconfig.json && node scripts/build.mts --minify && vsce package --no-dependencies --allow-missing-repository --out specflow-vscode.vsix"
  },
  "dependencies": {
    "@specflow/adapter-claude-code": "workspace:*",
    "@specflow/core": "workspace:*",
    "@vscode/codicons": "0.0.46-24",
    "preact": "^11.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/preact": "^3.2.6",
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "ovsx": "^1.3.0"
  }
}
