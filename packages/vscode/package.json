{
  "name": "specflow-vscode",
  "displayName": "Specflow",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --sourcemap --outfile=dist/extension.js"
  },
  "dependencies": {
    "@specflow/adapter-claude-code": "workspace:*",
    "@specflow/core": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "~1.90.0",
    "esbuild": "^0.28.2"
  }
}
